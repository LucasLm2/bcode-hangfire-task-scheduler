{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "HangfireConnection": "Host=localhost;Port=5432;Database=HangfireTaskScheduler;Username=postgres;Pooling=true;Connection Lifetime=0;"
  },
  "RabbitMQ": {
    "HostName": "",
    "UserName": "",
    "Password": "",
    "Port": 5672
  },
  "HangfireServer": {
    "WorkerCount": 0,
    "WorkerMultiplier": 5,
    "Queues": [ "bcstatus", "compartilhada" ],
    "ServerTimeoutMinutes": 5,
    "ShutdownTimeoutMinutes": 5,
    "HeartbeatIntervalSeconds": 30,
    "CancellationCheckIntervalSeconds": 15,
    "AutomaticRetryAttribute": {
      "Attempts": 3
    },
    "Console": {
      "ExpireDays": 7,
      "BackgroundColor": "#000000",
      "TextColor": "#00ff00",
      "TimestampColor": "#00ffff"
    },
    "Dashboard": {
      "DisplayStorageConnectionString": true,
      "IsReadOnly": false,
      "StatsPollingInterval": 2000
    }
  }
}
